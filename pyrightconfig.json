{
  "include": ["."],
  "exclude": ["**/__pycache__", ".venv", ".pytest_cache", ".idea", ".omo", "wavs", "tests"],
  "extraPaths": ["."],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": "none",
  "reportMissingModuleSource": "none",
  "useLibraryCodeForTypes": true
}
